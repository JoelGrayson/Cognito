# Copy to .env.local and fill in whichever providers you want to use.
# The UI only enables providers that are configured.

# Supabase Postgres connection string (server-only, never NEXT_PUBLIC_).
# Use the SSL options supplied by Supabase, e.g. ?sslmode=require.
# Local Docker Postgres (`docker compose up -d --wait`); set both URLs:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cognition
# DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cognition
DATABASE_URL=
# Optional direct/session-pooler connection for migrations and Studio.
DIRECT_DATABASE_URL=

# Better Auth: generate a secret with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Optional: extra origins allowed to sign in, comma-separated. Needed when the app is
# reached through a tunnel, e.g. https://your-name.ngrok-free.dev for testing on a tablet.
BETTER_AUTH_TRUSTED_ORIGINS=

# Google sign-in (optional). Google Cloud Console → APIs & Services → Credentials
# → OAuth client ID (web). Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Phase 0 switches. MOCK_AI=true uses deterministic mocks (no API calls).
# REPO_IMPL=memory keeps data in process memory (dev only — on serverless hosts each instance
# has its own copy); drizzle persists through DATABASE_URL. Unset, drizzle is used when DATABASE_URL is set.
MOCK_AI=true
MOCK_AI_DELAY_MS=0
# MOCK_AI_FAIL_CONCEPTS=true   # force the concepts call to fail (or use a goal containing "failtest")
# MOCK_AI_FAIL_GRAPH=true     # force graph generation to fail
# MOCK_AI_FAIL_EDIT=true      # force graph edits to fail (or use a message containing "failtest")
# MOCK_AI_FAIL_ENRICH=true    # fail every module; use a core node ID to fail only that module
# MOCK_AI_FAIL_GRADE=true     # force teacher-mode page grading to fail
# REPO_IMPL=memory

# Cerebras (default provider), reached through OpenRouter with routing pinned to Cerebras.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-oss-120b

# OpenAI
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5

# ChatGPT: users sign in with their own plan; no separate provider API key.
# Requires DATABASE_URL, BETTER_AUTH_SECRET, and BETTER_AUTH_URL above.
# CHATGPT_MODEL=gpt-5.5

# Grok (xAI)
XAI_API_KEY=
# XAI_MODEL=grok-4

# Claude
ANTHROPIC_API_KEY=
# Optional alternative to ANTHROPIC_API_KEY: bearer authentication token.
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_MODEL=claude-opus-5

# Local model via Ollama (default), LM Studio, vLLM or llama.cpp.
# Nothing to set for Ollama: just `ollama pull qwen3:8b` and keep it running.
# LOCAL_BASE_URL=http://localhost:11434/v1
# LOCAL_MODEL=qwen3:8b
# LOCAL_API_KEY=ollama

# Firecrawl: web search for lesson further-reading links, and a YouTube search
# fallback when no YOUTUBE_API_KEY is set. Without it the model suggests links itself.
FIRECRAWL_API_KEY=

# Optional: pick lesson videos through the YouTube Data API instead of the public search page.
# YOUTUBE_API_KEY=

# Required for live voice lessons and for the whiteboard tutor's voice: Deepgram
# Voice Agent manages speech, interruption, and the tutor model. No separate OpenAI
# key or ChatGPT sign-in is needed for calls.
# Use a Deepgram key with Member permissions to mint short-lived browser tokens.
DEEPGRAM_API_KEY=
# Optional voice for the standalone /api/voice/tts endpoint; live calls use Aura 2 Thalia.
# DEEPGRAM_TTS_MODEL=aura-2-thalia-en

# Optional: your own Desmos API key for the whiteboard's graph panel. It is sent to
# the browser, so it must be a public key. Left empty, the panel uses the demo key
# Desmos publishes for development; get one at https://www.desmos.com/api for
# production. https://www.desmos.com/api/v1.11/docs/
# NEXT_PUBLIC_DESMOS_API_KEY=

# Jev (TypeSafe AI): typed decisions — routing, gating, reranking — beside the
# text models. Optional: every caller falls back when it is unset. Key from
# console.typesafe.ai; MOCK_AI=true answers locally instead.
TYPESAFE_API_KEY=
# MOCK_JEV_FAIL=true          # with MOCK_AI, fail every Jev call to exercise fallbacks

# Mathpix: required for whiteboard handwriting recognition (server-only).
MATHPIX_APP_ID=
MATHPIX_APP_KEY=

# Gemini: optional second reader for hand-drawn chemical structures, asked only when
# Mathpix reads nothing or is unsure. Without it, those drawings are left unjudged.
GEMINI_API_KEY=
# GEMINI_STRUCTURE_MODEL=gemini-3.8-flash
