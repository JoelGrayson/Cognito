# Copy to .env.local and fill in whichever providers you want to use.
# The UI only enables providers that are configured.

# Supabase Postgres connection string (server-only, never NEXT_PUBLIC_).
# Use the SSL options supplied by Supabase, e.g. ?sslmode=require.
# Local Docker Postgres (`docker compose up -d --wait`); set both URLs:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/structured_learning
# DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/structured_learning
DATABASE_URL=
# Optional direct/session-pooler connection for migrations and Studio.
DIRECT_DATABASE_URL=

# Better Auth: generate a secret with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Phase 0 switches. MOCK_AI=true uses deterministic mocks (no API calls).
# REPO_IMPL=memory keeps data in process memory; drizzle arrives in Phase 1.
MOCK_AI=true
MOCK_AI_DELAY_MS=0
# MOCK_AI_FAIL_CONCEPTS=true   # force the concepts call to fail (or use a goal containing "failtest")
# MOCK_AI_FAIL_GRAPH=true     # force graph generation to fail
# MOCK_AI_FAIL_EDIT=true      # force graph edits to fail (or use a message containing "failtest")
# MOCK_AI_FAIL_ENRICH=true    # fail every module; use a core node ID to fail only that module
REPO_IMPL=memory

# OpenAI (default provider)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5

# ChatGPT: users sign in with their own plan; no separate provider API key.
# Requires DATABASE_URL, BETTER_AUTH_SECRET, and BETTER_AUTH_URL above.
# CHATGPT_MODEL=gpt-5.5

# Grok (xAI)
XAI_API_KEY=
# XAI_MODEL=grok-4

# Claude
ANTHROPIC_API_KEY=
# Optional alternative to ANTHROPIC_API_KEY: bearer authentication token.
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_MODEL=claude-opus-5

# Local model via Ollama (default), LM Studio, vLLM or llama.cpp.
# Nothing to set for Ollama: just `ollama pull qwen3:8b` and keep it running.
# LOCAL_BASE_URL=http://localhost:11434/v1
# LOCAL_MODEL=qwen3:8b
# LOCAL_API_KEY=ollama

# Optional: pick lesson videos through the YouTube Data API instead of the public search page.
# YOUTUBE_API_KEY=

# Deepgram (voice lessons: live speech-to-text + Aura text-to-speech). Without it the browser's built-in speech is used.
DEEPGRAM_API_KEY=
# DEEPGRAM_TTS_MODEL=aura-2-thalia-en

# Mathpix: required for whiteboard handwriting recognition (server-only).
MATHPIX_APP_ID=
MATHPIX_APP_KEY=
